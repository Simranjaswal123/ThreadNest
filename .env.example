# Template only. Copy this file to ".env" and change the values.
# Everything here is a dummy value. Never put real secrets in this file.

# Shop
SHOP_NAME=Threadnest

# Database container (read by docker-compose.yml)
POSTGRES_USER=threadnest
POSTGRES_PASSWORD=change_me_dummy_password
POSTGRES_DB=threadnest
POSTGRES_PORT=5432

# Connection string the Node server will use (from T3 onwards).
# It must repeat the user, password, port and database above.
DATABASE_URL=postgres://threadnest:change_me_dummy_password@localhost:5432/threadnest

# API server (from T3 onwards)
PORT=3000
# The React dev server. Only this origin may call the API from a browser (CORS allowlist).
FRONTEND_ORIGIN=http://localhost:5173
# Login attempts allowed per IP in 15 minutes (optional, default 20).
LOGIN_RATE_LIMIT_MAX=20

# Signs login tokens (from T4 onwards). Use a long random value in your real .env.
JWT_SECRET=change_me_dummy_secret
