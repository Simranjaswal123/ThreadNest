# Secrets: the real .env holds passwords and keys, so it must never be committed.
# (.env.example is the safe template and IS committed.)
.env
.env.*
!.env.example

# Installed packages: anyone can recreate them with "npm install".
node_modules/

# Build output: generated by Vite, not written by us.
dist/
build/

# Test coverage reports: generated files.
coverage/

# Logs.
*.log
npm-debug.log*

# Editor and operating system clutter.
.vscode/
.idea/
.DS_Store
Thumbs.db
