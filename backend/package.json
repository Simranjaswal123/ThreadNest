{
  "name": "threadnest-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "node --env-file=../.env src/db/migrate.js",
    "seed": "node --env-file=../.env src/db/runSeed.js",
    "start": "node --env-file=../.env src/server.js",
